--- !u!114 &1515152225
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1515152221}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96037582be927a449a939c63b775c719, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.14117648, g: 0.16078432, b: 0.18431373, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_Text: "# SSMarkdown\n\nA **runtime Markdown renderer** for *Unity UGUI*. Assign
    a Markdown string or a `TextAsset` to the component exactly like `UnityEngine.UI.Text`,
    and SSMarkdown parses, lays out and draws the document into the Canvas.\n\nIt
    does not depend on TextMeshPro or any third-party package.\n\n## Features\n\n1.
    Pure UGUI `MaskableGraphic` rendering\n2. Runtime parsing with no editor-only
    dependencies\n3. Rich text styling through Unity's `TextGenerator`\n4. Clickable
    links with `onLinkClicked`\n5. Works in ScrollRects and layout groups\n\n> The
    component handles the common documentation subset of Markdown.\n> Unsupported
    constructs simply fall back to readable plain text.\n\n## Assigning a document\n\n```csharp\nusing
    SS.UIComponent;\nusing UnityEngine;\n\npublic class ReadmePanel : MonoBehaviour\n{\n   
    [SerializeField] private MarkdownText m_View;\n\n    public void Show(string
    markdown)\n    {\n        m_View.text = markdown;\n    }\n\n    public void ShowAsset(TextAsset
    asset)\n    {\n        m_View.SetMarkdown(asset);\n    }\n}\n```\n\n## Lists\n\n-
    Inline **bold**, *italic*, ~~strikethrough~~ and `code`\n- Links such as [the
    Unity manual](https://docs.unity3d.com/Manual/)\n- Nested items\n  - with the
    same word-wrapping behavior\n  - as every other block\n\n1. Ordered lists keep
    their source numbers\n2. The marker column is measured from the font\n\n## Quotes\n\n>
    Good runtime documentation should be readable without leaving the game.\n> Links,
    code and emphasis all remain interactive inside a quote.\n\n## Code\n\n```csharp\nvar
    view = gameObject.AddComponent<MarkdownText>();\nview.text = \"# Hello\\n\\nThis
    is **Markdown**.\";\nview.onLinkClicked.AddListener(url => Debug.Log(url));\n```\n\n##
    Links and images\n\nVisit <https://unity.com> or click [the API documentation](https://example.com/docs).\n\nImage
    syntax is supported as its alt text: ![SSMarkdown logo](logo.png).\n\nThe end.\n"
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_FontSize: 17
  m_Alignment: 0
  m_Padding: {x: 6, y: 4, z: 6, w: 48}
  m_Theme:
    headingColor: {r: 0.050980393, g: 0.078431375, b: 0.11764706, a: 1}
    linkColor: {r: 0.03529412, g: 0.4117647, b: 0.85490197, a: 1}
    linkUnderlineColor: {r: 0.03529412, g: 0.4117647, b: 0.85490197, a: 0.5882353}
    codeColor: {r: 0.6392157, g: 0.22745098, b: 0.35686275, a: 1}
    codeBlockTextColor: {r: 0.14117648, g: 0.16078432, b: 0.18431373, a: 1}
    quoteColor: {r: 0.34117648, g: 0.3764706, b: 0.41568628, a: 1}
    inlineCodeBackgroundColor: {r: 0.6862745, g: 0.72156864, b: 0.75686276, a: 0.1764706}
    codeBlockBackgroundColor: {r: 0.6862745, g: 0.72156864, b: 0.75686276, a: 0.13725491}
    codeBlockAccentColor: {r: 0.03529412, g: 0.4117647, b: 0.85490197, a: 0.627451}
    quoteBarColor: {r: 0.6862745, g: 0.72156864, b: 0.75686276, a: 0.8235294}
    ruleColor: {r: 0.6862745, g: 0.72156864, b: 0.75686276, a: 0.627451}
    listMarkerColor: {r: 0.34117648, g: 0.3764706, b: 0.41568628, a: 1}
    strikeThroughColor: {r: 0.34117648, g: 0.3764706, b: 0.41568628, a: 0.78431374}
    lineSpacing: 1.18
    paragraphSpacing: 10
    headingTopSpacing: 18
    headingBottomSpacing: 7
    listSpacing: 3
    listIndent: 20
    listMarkerGap: 8
    quoteIndent: 16
    quoteBarWidth: 3
    codePadding: 10
    codeBlockSpacing: 10
    ruleSpacing: 14
    ruleThickness: 1
    bulletSize: 4
    codeFontScale: 0.9
    quoteFontScale: 1
    underlineLinks: 1
    drawInlineCodeBackground: 1
    drawCodeBlockBackground: 1
    drawHeadingRules: 1
    drawBullets: 1
    headingScales:
    - 1.9
    - 1.55
    - 1.3
    - 1.15
    - 1.05
    - 1
  m_EnableLinks: 1
  m_OnLinkClicked:
    m_PersistentCalls:
      m_Calls: []
