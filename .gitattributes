# Normalize line endings for source assets. Unity serializes YAML with LF.
* text=auto eol=lf

*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.ttf binary
*.otf binary
*.zip binary
*.unitypackage binary
