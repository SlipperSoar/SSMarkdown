# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset store tools
Assets/AssetStoreTools*

# Autogenerated VS/Rider files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.DotSettings.user

# Crash reports
sysinfo.txt
*.stackdump

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / tool output
TestResults.xml
LinkResults.xml
[Dd]ocumentation~/*.tmp
[Tt]ools~/**/bin/
[Tt]ools~/**/obj/
*.log

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app

# Keep the standalone parser test project
!Tools~/ParserTests/ParserTests.csproj

# Machine-specific package manager settings
**/ProjectSettings/PackageManagerSettings.asset

# Let each Unity installation resolve against its own registry
**/Packages/packages-lock.json

# Unity may create meta files for package-root docs/tooling when the package is
# referenced through a local file: dependency. Only the code folders need metas.
/*.meta
!/Runtime.meta
!/Editor.meta
!/Tests.meta
/Documentation~/*.meta
/Tools~/**/*.meta
